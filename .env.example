# ── 环境档：dev(开发) / t0 / t1 / t2（见 §2.3 四档拓扑）──
ZHY_ENV=dev

# ── 数据库（方言由安装期探测写入 sys_compat_flags，运行时不猜连接串）──
ZHY_DB_URL=sqlite:///./zhy_edu.db
ZHY_DB_FLAVOR=                    # 留空=自动探测；可显式 opengauss_5/opengauss_6/opengauss_7/kingbase
ZHY_DB_OG_VERSION=                # 安装期探测回填，doctor 校验

# ── 安装向导（M1.5；留空=启动期生成并打印到日志，安装完成后作废）──
ZHY_INSTALL_TOKEN=

# ── 认证（RS256 密钥对不进镜像，安装期生成）──
ZHY_JWT_PRIVATE_KEY_PATH=./run/keys/jwt_private.pem
ZHY_JWT_PUBLIC_KEY_PATH=./run/keys/jwt_public.pem
ZHY_AT_TTL_SEC=1800               # 改密窗口上限=AT TTL（Q20 默认 30min）

# ── 进度网关（F2，§12.5 / 附录 B）──
ZHY_PROGRESS_RING_DIR=/run/zhy/progress
ZHY_PROGRESS_FLUSH_BATCH=200
ZHY_PROGRESS_FLUSH_INTERVAL_SEC=15
ZHY_PROGRESS_LEASE_TTL_SEC=30
ZHY_PROGRESS_BUS=local            # local | redis-stream
ZHY_PROGRESS_RECOVERY_MAX_GAP=10000  # gw_seq 缺口告警阈值
ZHY_PROGRESS_COMPLETION_THRESHOLD=90 # percent 且位置到结尾才判完成
ZHY_REDIS_URL=                    # bus=redis-stream 时必填

# ── 题库判分（F5 · §10.4）──
ZHY_QUIZ_PASS_SCORE=60            # 及格线（百分比），交卷时判 passed

# ── 双模式（§9.3 / §9.6 · M2.10）──
ZHY_MODE_CACHE_TTL_SEC=30            # epoch 快照缓存；切换后全站生效 ≤30s
ZHY_MODE_QUARANTINE_WINDOW_SEC=3600  # 切换窗口内 source=preview 流水隔离范围
ZHY_MODE_TICKET_WARN_THRESHOLD=1000  # 有效票据数超过则切换报告告警

# ── 视频票据与三层 TTL（F3/F4/F8，§21.4）──
ZHY_MEDIA_TTL_TS_SEC=259200
ZHY_MEDIA_TTL_PLAYLIST_SEC=900
ZHY_MEDIA_TTL_KEY_SEC=120
ZHY_MEDIA_TICKET_SLACK_SEC=20
ZHY_MEDIA_KSESSION_STRICT_IP=false
ZHY_MEDIA_CDN_BASE=               # 空=应用相对路径；CDN 部署填 https://cdn.example.com
ZHY_MEDIA_NONCE_REUSE_WINDOW_SEC=30  # key nonce 复用窗口（播放器重复请求）
ZHY_MEDIA_SUPERSEDED_GRACE_SEC=120   # 换票后旧 keysession 宽限期
ZHY_MEDIA_AES_KEY_HEX=            # 32字节 hex，安装期生成，不可回显

# ── 转码沙箱（F7，§10.3.2.3）──
ZHY_TRANSCODE_SANDBOX=bwrap       # bwrap | cgroup_systemd | disabled(仅 dev)
ZHY_TRANSCODE_CPU_MAX_PERCENT=200
ZHY_TRANSCODE_MEM_MAX_MB=2048
ZHY_TRANSCODE_PIDS_MAX=16
ZHY_TRANSCODE_INPUT_MAX_DURATION_SEC=14400
ZHY_TRANSCODE_INPUT_MAX_DIM=4096
ZHY_TRANSCODE_ALLOWED_FORMATS=mp4,mov,mkv,flv,webm,mp3,aac
ZHY_TRANSCODE_PROFILES=360,720      # 仅允许 360/720/1080；ffmpeg 逐档独立输出
ZHY_TRANSCODE_SEGMENT_SEC=4
ZHY_TRANSCODE_POSTER_SEC=3
ZHY_TRANSCODE_MAX_ATTEMPTS=2        # 失败重试上限（含首次）
ZHY_TRANSCODE_RETRY_BACKOFF_SEC=60
ZHY_TRANSCODE_WORKER_POLL_SEC=3
ZHY_TRANSCODE_QUEUE_BATCH=4         # 单轮最多消费任务数
ZHY_TRANSCODE_FFPROBE_TIMEOUT_SEC=15
ZHY_TRANSCODE_TASK_TIMEOUT_SEC=3600 # 单任务硬超时；也是崩溃回收判据
ZHY_TRANSCODE_PAUSED=false          # CVE 命中/人工暂停：只拦新入队
ZHY_FFMPEG_CVE_PAUSE_ON_HIT=true
ZHY_FFMPEG_SBOM_PATH=./deploy/ffmpeg/zhy-ffmpeg-sbom.json

# ── 分片上传与 tmp 安全（M2.3，§10.3.1）──
ZHY_UPLOAD_TMP_ROOT=./var/tmp/uploads
ZHY_UPLOAD_CHUNK_SIZE=8388608
ZHY_UPLOAD_MAX_FILE_BYTES=8589934592
ZHY_UPLOAD_MAX_CHUNKS=4096
ZHY_UPLOAD_SESSION_TTL_SEC=86400
ZHY_UPLOAD_TMP_TTL_SEC=600        # 合并后 10 分钟未消费由 tmp-reaper 清理
ZHY_UPLOAD_REQUIRE_FFPROBE=false  # 非 dev 环境必须为 true（魔数检疫在 Web 进程执行）

# ── 用户 / 班级 / 导入 / 过期（M2.7，§10.5）──
ZHY_USERS_ON_CONFLICT_ACTION=report_only  # report_only 不覆盖原值；overwrite 显式覆盖
ZHY_USERS_IMPORT_MAX_ROWS=5000
ZHY_USERS_EXPIRE_HOUR=2                   # 每日 02:00 执行账号/会员过期
ZHY_USERS_EXPIRE_BATCH_SIZE=500

# ── 会员订单 / 支付回调（M2.12，§10.6）──
ZHY_PAY_CALLBACK_SECRET=dev-only-callback-secret  # 非 dev 必须替换，否则启动阻断
ZHY_PAY_ORDER_TTL_SEC=1800                # 订单支付窗口；超时置 expired
ZHY_PAY_MAX_OPEN_ORDERS=3                 # 单用户未关闭订单上限

# ── 存储（local | s3 | oss）──
ZHY_STORAGE_DRIVER=local
ZHY_STORAGE_LOCAL_DIR=./var/storage
